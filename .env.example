# Credenziali (stesso agent wallet del sistema RAPS va bene)
HL_ACCOUNT_ADDRESS=0x...
HL_AGENT_PRIVATE_KEY=0x...
HL_ENV=mainnet

# Sub-account su cui opera questa strategia (CONSIGLIATO, vedi README): lascia vuoto per usare l'account principale
HL_VAULT_ADDRESS=

# Sicurezza: finche' e' true non invia ordini reali
DRY_RUN=true

# Capitale assegnato a questa strategia (USD) e moltiplicatore (1.0 = nessuna leva, come TradingView)
STRAT_CAPITAL_USD=500
LEVERAGE_FACTOR=1.0

# true = al primo avvio non entri nello stato corrente, aspetti il prossimo flip della strategia
WAIT_FOR_FLIP=false
